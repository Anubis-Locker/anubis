#!/bin/bash
# Publish the client package: tags client-v<package.json version> and pushes the tag.
# The tag triggers .github/workflows/web-client-publish.yml (npm publish to our registry).
# Usage: src/build/bin/web-release [remote]   (default remote: origin)
set -euo pipefail
cd "$(dirname "$0")/../../.."
remote="${1:-origin}"
branch="$(git rev-parse --abbrev-ref HEAD)"
version="$(node -p "require('./package.json').version")"
tag="client-v$version"

if [ -n "$(git status --porcelain)" ]; then
  echo "working tree is not clean" >&2; exit 1
fi
if git rev-parse -q --verify "refs/tags/$tag" >/dev/null; then
  echo "tag $tag already exists" >&2; exit 1
fi

git pull --ff-only "$remote" "$branch"
git push "$remote" "$branch"
git tag -a "$tag" -m "client $tag"
git push "$remote" "$tag"
echo "pushed $tag - watch the 'web-client-publish' workflow"
