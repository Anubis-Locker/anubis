{
  "appId": "locker.anubis.securitytool",
  "productName": "anubis",
  "directories": {
    "app": "work/app",
    "output": "dist",
    "buildResources": "@brand-res/build-res"
  },
  "electronLanguages": [
    "en-US"
  ],
  "asar": true,
  "afterPack": "./src/build/bin/after-pack.js",
  "asarUnpack": [
    "node_modules/node-pty/build/Release/**"
  ],
  "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
  "win": {
    "requestedExecutionLevel": "asInvoker",
    "target": [
      "tar.gz",
      "appx",
      "nsis"
    ],
    "icon": "@brand-res/res/icons/win/icon.ico",
    "publish": {
      "provider": "generic",
      "url": "${env.ANUBIS_UPDATE_URL}/releases",
      "channel": "${env.WORKFLOW_NAME}"
    }
  },
  "protocols": [
    {
      "name": "SSH Protocol",
      "schemes": [
        "ssh"
      ]
    },
    {
      "name": "Telnet Protocol",
      "schemes": [
        "telnet"
      ]
    },
    {
      "name": "RDP Protocol",
      "schemes": [
        "rdp"
      ]
    },
    {
      "name": "VNC Protocol",
      "schemes": [
        "vnc"
      ]
    },
    {
      "name": "Serial Protocol",
      "schemes": [
        "serial"
      ]
    },
    {
      "name": "Spice Protocol",
      "schemes": [
        "spice"
      ]
    },
    {
      "name": "FTP Protocol",
      "schemes": [
        "ftp"
      ]
    },
    {
      "name": "Anubis Protocol",
      "schemes": [
        "anubis"
      ]
    }
  ],
  "fileAssociations": [
    {
      "ext": "vv",
      "name": "Virt Viewer connection file",
      "description": "SPICE console connection file (virt-viewer / remote-viewer)",
      "mimeType": "application/x-virt-viewer",
      "role": "Viewer"
    }
  ],
  "appx": {
    "applicationId": "anubis",
    "identityName": "ai-security-tool.anubis",
    "publisher": "CN=REPLACE-WITH-YOUR-PUBLISHER-ID",
    "publisherDisplayName": "ai-security-tool"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": true,
    "include": "src/build/windows-installer.nsh",
    "deleteAppDataOnUninstall": false,
    "artifactName": "${productName}-${version}-${os}-${arch}-installer.${ext}",
    "allowToChangeInstallationDirectory": false,
    "runAfterFinish": false,
    "installerIcon": "@brand-res/res/icons/win/icon.ico",
    "uninstallerIcon": "@brand-res/res/icons/win/icon.ico",
    "installerHeaderIcon": "@brand-res/res/icons/win/icon.ico",
    "installerHeader": "@brand-res/res/icons/nsis/installerHeader.bmp",
    "installerSidebar": "@brand-res/res/icons/nsis/installerSidebar.bmp",
    "uninstallerSidebar": "@brand-res/res/icons/nsis/uninstallerSidebar.bmp"
  },
  "mac": {
    "category": "public.app-category.developer-tools",
    "target": "dmg",
    "icon": "@brand-res/res/icons/mac/icon.icns",
    "publish": {
      "provider": "generic",
      "url": "${env.ANUBIS_UPDATE_URL}/releases",
      "channel": "${env.WORKFLOW_NAME}"
    },
    "hardenedRuntime": true,
    "gatekeeperAssess": false,
    "entitlements": "./src/build/entitlements.plist",
    "entitlementsInherit": "./src/build/entitlements.plist",
    "notarize": true
  },
  "dmg": {
    "contents": [
      {
        "x": 110,
        "y": 190
      },
      {
        "x": 440,
        "y": 190,
        "type": "link",
        "path": "/Applications"
      }
    ]
  },
  "linux": {
    "category": "Development;System;TerminalEmulator",
    "icon": "@brand-res/res/icons/linux",
    "target": [
      "rpm",
      "deb",
      "AppImage",
      "tar.gz",
      "snap"
    ],
    "publish": {
      "provider": "generic",
      "url": "${env.ANUBIS_UPDATE_URL}/releases",
      "channel": "${env.WORKFLOW_NAME}"
    },
    "desktop": {
      "entry": {
        "StartupWMClass": "anubis"
      }
    }
  },
  "snap": {
    "confinement": "classic",
    "publish": {
      "provider": "generic",
      "url": "${env.ANUBIS_UPDATE_URL}/releases",
      "channel": "${env.WORKFLOW_NAME}"
    }
  },
  "deb": {
    "afterInstall": "src/build/bin/linux-deb-after-build.sh",
    "depends": [
      "libgtk-3-0",
      "libnotify4",
      "libnss3",
      "libxss1",
      "libxtst6",
      "xdg-utils",
      "libatspi2.0-0",
      "libuuid1",
      "libsecret-1-0",
      "libasound2t64 | libasound2"
    ]
  }
}
