
.animate-fast
  animation-duration .2s
.sidebar-panel
  position absolute
  left 0
  top 0
  bottom 0
  z-index 200
  width 0
  overflow-y scroll
  background var(--main)
  .item-list-unit:hover
    .list-item-remove
      display none !important
.sidebar-panel
  top 36px
.sidebar
  position absolute
  left 0
  top 0
  width 36px
  z-index 100
  bottom 0
  background var(--main-dark)
  display flex
  flex-direction column

  .item-list
    padding-right 0
// With the panel open the column carries an overlay (the unpinned bookmarks /
// history panel), and `.sidebar` is its own stacking context: the panel's own
// z-index 200 is measured inside this 100, so root-level chrome still paints
// over it — the footer escapes it only because it reserves the panel's width
// (footer-entry.jsx), while the remote monitor bar (z-index 188) spans the same
// x range as the panel and hides its bottom 28px. Lift the whole column so the
// overlay wins, the same way mobile.styl does for the drawer. Pinned needs no
// lift (the layout reserves the column and nothing overlaps it), but the class
// is on either way and lifting it there is harmless. Same pattern as the right
// panel, which is a root-level child and covers the bar on its own.
.sidebar.type-bookmarks
.sidebar.type-history
  z-index 250
.sidebar-pin-top
  position absolute
  left 0
  right 0
  top 0
  height 112px
.sidebar-panel-bookmarks
.sidebar-panel-history
  position absolute
  left 0
  right 0
  top 112px
  bottom 0
  overflow hidden
  display flex
  flex-direction column
  .sidebar-inner
    flex 1
    display flex
    flex-direction column
    overflow hidden
    min-height 0
  .history-header
    flex-shrink 0
    display flex
    align-items center
    border-bottom 1px solid var(--border)
    position sticky
    top 0
    z-index 10
    background var(--main)
    .history-sort
      display flex
      align-items center
      gap 6px
    .history-sort-label
      user-select none
    .history-clear-icon
      margin-left auto
      margin-right 0
      color var(--text-dark)
      &:hover
        color var(--error)
  .history-body
    flex 1
    overflow-y auto
    overflow-x hidden
.not-system-ui.is-mac
  .sidebar-bar
    margin-top 20px
.type-bookmarks
  .bookmarks-panel
    width 100%
.type-history
  .history-panel
    width 100%
.control-icon-text
  color var(--text)
  &:hover
    color var(--success)
.control-icon-wrap
  padding 14px 0
  text-align center
  &.active
    .control-icon
      color var(--text-light)
  .control-icon
    color var(--text-dark)
    cursor pointer
    &:hover
      color var(--text-light)
.sidebar-list
  position absolute
  left var(--left-side-bar-width, 43px)
  top 0
  bottom 0
  z-index 200
  width 0

// icon bar: fills sidebar height, scrolls when overflow on small screens,
// scrollbar hidden but scrolling still works
.sidebar-bar
  flex 1
  min-height 0
  overflow-y auto
  overflow-x hidden
  scrollbar-width none // Firefox
  -ms-overflow-style none // IE/Edge
  &::-webkit-scrollbar
    width 0
    height 0
    display none

// mobile: icon bar hidden — hide its buttons
.sidebar.collapsed
  .sidebar-bar
    display none

.pinned
  .sidebar-list
    top 0
    .sidebar-panel
      top 0
      padding-top 36px
  .drag-handle
    display block
  .sidebar-panel
    .pinned
      color var(--success)
//btns
.btns
  background var(--main-dark)
  border-color var(--primary)
  .open-about-icon
    color var(--text-dark)
    &:hover
      color var(--text-light)
  .zoom-reset-icon
    color var(--primary)
    &:hover
      color var(--text-light)

.btns .upgrade-icon
  color var(--success)
.close-info-modal
  cursor pointer
  &:hover
    color var(--text-light)
.logo-filter
  filter invert(80%)
.sidebar-inner
  padding-right 8px

.sidebar
  box-sizing border-box
  border-right 1px solid var(--ui-border)
  .sidebar-nav-label
  .sidebar-brand-name
    display none
  .sidebar-bar
    padding 0 5px 12px
    > .control-icon-wrap:first-child
      box-sizing border-box
      height 60px
      padding 12px 0
      margin 0 -5px 8px
      border-bottom 1px solid var(--ui-border)
      border-radius 0
  button.control-icon-wrap
    display flex
    align-items center
    justify-content center
    gap 12px
    width 100%
    min-height 40px
    margin 3px 0
    padding 9px 4px
    border 0
    border-radius 8px
    background transparent
    color var(--text-dark)
    font inherit
    font-size 14px
    cursor pointer
    .control-icon
      font-size 19px
      color inherit
    &:hover
    &.active
      background var(--ui-hover)
      color var(--text)
    &:focus-visible
      outline 2px solid var(--primary)
      outline-offset -2px
  .menu-control
    display flex
    align-items center
    justify-content center
    gap 10px
    width 100%
    height 36px
    padding 0
    border 0
    border-radius 8px
    background transparent
    color var(--text)
    font inherit
    &:focus-visible
      outline 2px solid var(--primary)
  .menu-logo
    display inline-flex
    align-items center
    justify-content center
    flex-shrink 0
    width 30px
    height 30px
    font-size 22px
    border-radius 9px
    color var(--primary-contrast)
    background var(--primary)
    svg
      fill none
  &.sidebar-expanded
    .sidebar-bar
      padding-left 10px
      padding-right 10px
      > .control-icon-wrap:first-child
        margin-left -10px
        margin-right -10px
        padding-left 16px
        padding-right 16px
    .menu-control
      justify-content flex-start
      text-align left
    .sidebar-brand-name
      display block
      font-size 13px
      font-weight 600
      line-height 1.4
      overflow-wrap anywhere
    .sidebar-nav-label
      display block
      min-width 0
      text-align left
      overflow-wrap anywhere
      line-height 1.4
    button.control-icon-wrap
      justify-content flex-start
      padding 10px 12px
      > .anticon
      > .ant-badge
        flex-shrink 0