.sidebar.sidebar-menu-preview
  display flex
  flex-direction column
  .preview-brand
    display flex
    align-items center
    flex-shrink 0
    height 60px
    padding 0 16px
    border-bottom 1px solid var(--ui-border)
  .preview-navigation
    flex 1
    min-height 0
    overflow-y auto
    overflow-x hidden
    padding 12px 10px
    scrollbar-width thin
  .preview-group
    & + .preview-group
      margin-top 14px
      padding-top 14px
      border-top 1px solid var(--ui-border)
    summary
      display flex
      align-items center
      gap 9px
      padding 5px 10px 10px
      list-style none
      color var(--text-dark)
      font-size 11px
      font-weight 600
      cursor pointer
      &::-webkit-details-marker
        display none
      > svg:first-child
        color inherit
      .preview-chevron
        margin-left auto
        transform rotate(-90deg)
    &[open] .preview-chevron
      transform rotate(0)
  .preview-menu-item
    display flex
    align-items center
    gap 11px
    width 100%
    min-height 36px
    margin 2px 0
    padding 8px 12px
    border 0
    border-radius 7px
    background transparent
    color var(--text-dark)
    font inherit
    font-size 13px
    text-align left
    cursor pointer
    > svg
      flex-shrink 0
    &:hover
    &.active
      background var(--ui-hover)
      color var(--text)
    &:focus-visible
      outline 2px solid var(--primary)
      outline-offset -2px
    &:disabled
      opacity .45
      cursor not-allowed
  .preview-footer
    display flex
    flex-direction column
    align-items center
    gap 8px
    flex-shrink 0
    min-height 34px
    max-height 40%
    overflow-y auto
    overflow-x hidden
    padding 4px 10px
    border-top 1px solid var(--ui-border)
    color var(--text-dark)
    font-size 10px
    &:empty
      display none
    .zoom-reset-icon
      color var(--primary)
    .upgrade-icon
      color var(--success)
  &.preview-compact
    .preview-label
    .preview-chevron
      display none
    .preview-brand
      padding 0 5px
    .preview-navigation
      padding 10px 5px
    .preview-group summary
    .preview-menu-item
      justify-content center
      padding-left 0
      padding-right 0
    .preview-footer
      justify-content center
      padding 4px 5px
  &.collapsed
    .preview-brand
    .preview-navigation
    .preview-footer
      display none
