:root
  --main #1B1B1B
  --main-dark #101010
  --main-light #303030
  --text #E8E8E8
  --text-light #FAFAFA
  --text-dark #B4B4B4
  --text-disabled #858585
  --primary #E8E8E8
  --info #A3A3A3
  --success #34D399
  --error #F87171
  --warn #FBBF24
  --primary-contrast #101010
  --main-darker #131313
  --main-lighter #5f5f5f
  --ui-border unquote('color-mix(in srgb, var(--text) 16%, transparent)')
  --ui-hover unquote('color-mix(in srgb, var(--text) 7%, transparent)')
