{
  "name": "anubis",
  "version": "5.7.2",
  "description": "Anubis-Security-Tool: terminal/ssh/sftp/telnet/serialport/RDP/VNC/Spice/ftp client (Linux, macOS, Windows).",
  "main": "app.js",
  "scripts": {
    "app": "node src/build/bin/app",
    "build": "npm run vite-build",
    "start": "node src/build/bin/start.js",
    "clean": "node src/build/bin/clean",
    "compile": "node src/build/bin/build",
    "vite-build": "node src/build/bin/vite-build.js",
    "prepare-file": "node src/build/bin/prepare",
    "pb": "node src/build/bin/prepare-electron-build.js",
    "prepare-test": "node -e \"require.resolve('@playwright/test'); require.resolve('playwright')\"",
    "postinstall": "node src/build/bin/post-install",
    "lint": "standard --verbose",
    "fix": "standard --fix",
    "test": "npm run test1 && npm run test2",
    "test-unit-ci": "node --test src/test/unit-ci/*.spec.js",
    "test-packaged-windows": "node --test --test-concurrency=1 src/test/packaged/windows-smoke.js src/test/packaged/warm-cache-smoke.js",
    "test-integration": "node --test src/test/integration/*.spec.js",
    "test1": "./node_modules/.bin/playwright test src/test/e2e/00*.js --workers=1 --workers=1",
    "test2": "./node_modules/.bin/playwright test src/test/e2e/01*.js --workers=1",
    "test3": "./node_modules/.bin/playwright test src/test/e2e/02*.js --workers=1 && npm run test-unit-ci",
    "test4": "./node_modules/.bin/playwright test src/test/e2e/03*.js --workers=1",
    "clean-test-server": "node src/build/bin/clean-test-server-home.js",
    "b": "npm run clean && npm run compile && npm run prepare-file",
    "r": "./src/build/bin/release",
    "w": "./src/build/bin/web-release",
    "t": "./node_modules/.bin/electron work/app/app.js",
    "lock": "npm i --package-lock-only"
  },
  "license": "MIT",
  "languageRepo": "https://github.com/Anubis-Locker/anubis-locales",
  "privacyNoticeLink": "https://docs.anubis.locker/wiki/privacy-notice",
  "knownIssuesLink": "https://docs.anubis.locker/wiki/Know-issues",
  "sponsorLink": "https://anubis.locker/sponsor",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Anubis-Locker/anubis.git"
  },
  "author": {
    "name": "ai-security-tool",
    "email": "support@anubis.locker",
    "url": "https://github.com/Anubis-Locker"
  },
  "bugs": {
    "url": "https://github.com/Anubis-Locker/anubis/issues"
  },
  "homepage": "https://anubis.locker",
  "releases": "https://github.com/Anubis-Locker/anubis/releases",
  "engines": {
    "node": ">=16.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "playwright": "1.64.1",
    "@ai-security-tool/icons": "1.0.1",
    "@ai-security-tool/resource": "2.2.2",
    "@ant-design/icons": "6.2.5",
    "@fontsource/maple-mono": "^5.2.5",
    "@novnc/novnc": "1.7.0",
    "@types/node": "22.9.3",
    "@vitejs/plugin-react": "^5.2.0",
    "@xterm/addon-attach": "0.13.0-beta.292",
    "@xterm/addon-fit": "0.12.0-beta.292",
    "@xterm/addon-image": "0.10.0-beta.292",
    "@xterm/addon-ligatures": "0.11.0-beta.292",
    "@xterm/addon-search": "0.17.0-beta.292",
    "@xterm/addon-serialize": "0.15.0-beta.292",
    "@xterm/addon-unicode11": "0.10.0-beta.292",
    "@xterm/addon-web-links": "0.13.0-beta.292",
    "@xterm/addon-webgl": "0.20.0-beta.291",
    "@xterm/xterm": "npm:@ai-security-tool/xterm@6.1.0-beta.292-electerm.2",
    "antd": "6.5.1",
    "classnames": "2.5.1",
    "cross-env": "7.0.3",
    "dotenv": "16.4.5",
    "electron": "44.7.0",
    "electron-builder": "26.15.7",
    "filesize": "10.1.6",
    "filesize-parser": "1.5.1",
    "glob": "^13.0.6",
    "ironrdp-wasm": "1.2.0",
    "lodash-es": "^4.17.21",
    "lucide-react": "^1.61.0",
    "manate": "2.0.3",
    "morgan": "^1.12.0",
    "pug": "3.0.4",
    "react": "19.2.7",
    "react-diff-viewer-continued": "4.4.0",
    "react-dom": "19.2.7",
    "react-markdown": "9.0.1",
    "remark-gfm": "^4.0.1",
    "replace-in-file": "6.3.5",
    "shelljs": "0.8.5",
    "spice-client": "1.2.0",
    "standard": "^17.1.2",
    "stylus": "^0.64.0",
    "vite": "8.1.0"
  },
  "dependencies": {
    "@ai-security-tool/managed-access": "1.0.2",
    "@ai-security-tool/anubis-browser-assets": "5.6.11",
    "@ai-security-tool/ftp-srv": "^1.0.6",
    "@ai-security-tool/locales": "2.3.34",
    "@ai-security-tool/nedb": "2.0.0",
    "@ai-security-tool/ssh2": "1.22.1",
    "@ai-security-tool/ssh2-scp": "3.3.0",
    "@ai-security-tool/sync": "2.1.0",
    "@ai-security-tool/themes": "1.0.2",
    "@ai-security-tool/trzsz2": "1.2.0",
    "@xterm/headless": "6.1.0-beta.292",
    "axios": "1.18.1",
    "basic-ftp": "6.0.1",
    "commander": "12.1.0",
    "diffie-hellman": "^5.0.3",
    "electron-log": "4.3.5",
    "express": "5.2.1",
    "express-ws": "5.0.2",
    "fast-deep-equal": "3.1.3",
    "find-free-port": "2.0.0",
    "font-list": "1.5.1",
    "https-proxy-agent": "7.0.1",
    "iconv-lite": "^0.7.2",
    "json-deep-copy": "1.3.1",
    "jsonwebtoken": "^9.0.1",
    "multer": "^2.3.0",
    "nanoid": "^3.3.16",
    "node-bash": "5.0.1",
    "node-forge": "1.4.0",
    "node-pty": "1.2.0-beta.15",
    "os-locale-s": "1.1.3",
    "serialport": "13.0.0",
    "socks": "2.8.9",
    "socks-proxy-agent": "8.0.1",
    "socksv5-server": "^1.0.2",
    "ssh-config-loader": "1.1.2",
    "tar": "7.5.21",
    "zmodem2": "1.4.0",
    "ws": "8.18.3"
  },
  "overrides": {
    "ip-address": "^10.3.1",
    "qs": "^6.16.0",
    "body-parser": "^2.3.0",
    "form-data": "^4.0.6",
    "fast-uri": "^3.1.6",
    "js-yaml": "^4.3.2",
    "@xmldom/xmldom": "^0.8.15",
    "browserslist": "^4.28.7",
    "baseline-browser-mapping": "^2.11.0",
    "postcss": "^8.5.23",
    "glob": {
      "minimatch": {
        "brace-expansion": "^5.0.7"
      }
    }
  },
  "standard": {
    "sourceType": "module",
    "ignore": [
      "work",
      "temp",
      "dist",
      "native/windows-host/out"
    ],
    "globals": [
      "log",
      "MouseEvent",
      "WebSocket",
      "FileReader",
      "CustomEvent",
      "ResizeObserver",
      "onmessage",
      "requestAnimationFrame",
      "self"
    ]
  },
  "allowScripts": {
    "@serialport/bindings-cpp@13.0.0": true,
    "node-pty@1.2.0-beta.15": true
  }
}
